#!/bin/sh /etc/rc.common
# Lifecycle entry for the ucode-owned procd service; deliberately no boot enable.
START=99
STOP=10

start() {
    [ "$(uci -q get vokop.settings.enabled)" = "1" ] || return 0
    [ ! -e /etc/vokop/vkturn-disabled ] || return 0
    /usr/bin/ucode -L /usr/lib/vokop /usr/lib/vokop/providers/vkturn/runtime.uc start-runtime
}
stop() {
    /usr/bin/ucode -L /usr/lib/vokop /usr/lib/vokop/providers/vkturn/runtime.uc stop-runtime
}
restart() {
    start
}
