#!/bin/sh /etc/rc.common
# Explicit local authorization is required; package installation does not enable management.
START=98
STOP=10
USE_PROCD=1

start_service() {
    local enabled
    config_load vokop_management
    config_get_bool enabled settings enabled 0
    [ "$enabled" = "1" ] || return 0
    procd_open_instance
    procd_set_param command /usr/bin/ucode -L /usr/lib/vokop /usr/lib/vokop/management/client.uc run
    procd_set_param respawn 3600 10 5
    procd_set_param file /etc/config/vokop_management
    # Status is published separately. Do not forward raw transport output to system logs.
    procd_set_param stdout 0
    procd_set_param stderr 0
    procd_set_param term_timeout 30
    procd_close_instance
}

service_triggers() {
    procd_add_reload_trigger vokop_management
}
