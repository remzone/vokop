{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "const": "vokop.ack.v1"
    },
    "results": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "status": {
            "enum": [
              "applied",
              "failed",
              "expired",
              "rejected"
            ]
          }
        },
        "required": [
          "id",
          "status"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "results"
  ],
  "additionalProperties": false,
  "$comment": "Panel must additionally bind each command ID to the authenticated device and persist identical repeated acknowledgements idempotently."
}
