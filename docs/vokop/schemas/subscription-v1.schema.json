{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "const": "vokop.subscription.v1"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "issued_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "expires_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
          },
          "name": {
            "type": "string",
            "maxLength": 100,
            "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
          },
          "vless": {
            "type": "object",
            "properties": {
              "uuid": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
              }
            },
            "required": [
              "uuid"
            ],
            "additionalProperties": false
          },
          "turn": {
            "type": "object",
            "properties": {
              "peer_host": {
                "type": "string",
                "minLength": 3,
                "maxLength": 253,
                "pattern": "^[A-Za-z0-9.-]+$"
              },
              "peer_port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              },
              "vk_call_url": {
                "type": "string",
                "maxLength": 2048,
                "pattern": "^https://(www\\.)?vk\\.com/call/join/[A-Za-z0-9_=-]+$"
              },
              "streams": {
                "type": "integer",
                "minimum": 1,
                "maximum": 16
              }
            },
            "required": [
              "peer_host",
              "peer_port",
              "vk_call_url",
              "streams"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "name",
          "vless",
          "turn"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "revision",
    "issued_at",
    "expires_at",
    "profiles"
  ],
  "additionalProperties": false,
  "$comment": "Additional client validation: duplicate raw JSON keys, distinct IDs, real host constraints, monotonic revision, current clock, <=300 seconds future issued_at, expiry after issued_at and <=31 days. Duplicate keys must be checked before JSON parsing."
}
